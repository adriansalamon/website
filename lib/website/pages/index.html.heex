<.layout page={:index}>
  <:head>
    <title>Adrian Salamon</title>
    <meta
      name="description"
      content="I'm Adrian, a Computer Science student and software engineer based in Stockholm."
    />
  </:head>

  <div class="px-6 pt-14 pb-4 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <div class="flex flex-col-reverse sm:flex-row sm:justify-between gap-y-10 sm:space-x-4">
        <div>
          <h1 class="text-3xl font-medium text-zinc-900 leading-tight font-serif dark:text-zinc-100 sm:text-4xl">
            Adrian Salamon
          </h1>
          <p class="mt-5 text-base text-zinc-500 leading-relaxed max-w-md dark:text-zinc-400">
            Hi, I'm Adrian! I study Computer Science (ML) at KTH and like to build things. Based in Stockholm, Sweden.
          </p>
          <div class="mt-6 flex items-center gap-4">
            <.link
              href="https://github.com/adriansalamon"
              class="text-zinc-400 transition-colors hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300"
              aria-label="GitHub"
            >
              <.social_icon name={:github} class="h-5 w-5 fill-current" />
            </.link>
            <.link
              href="https://linkedin.com/in/adriansalamon"
              class="text-zinc-400 transition-colors hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300"
              aria-label="LinkedIn"
            >
              <.social_icon name={:linkedin} class="h-5 w-5 fill-current" />
            </.link>
            <.link
              href="https://twitter.com/salamonadrian"
              class="text-zinc-400 transition-colors hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300"
              aria-label="Twitter"
            >
              <.social_icon name={:twitter} class="h-5 w-5 fill-current" />
            </.link>
          </div>
        </div>
        <div class="flex mr-auto aspect-3/4 h-32 sm:h-48 overflow-clip rounded-2xl sm:mr-0">
          <.image
            src="/assets/static/mexico.jpeg"
            alt="Adrian Salamon"
            class="object-contain object-center scale-195"
            sizes="300px"
          />
        </div>
      </div>
    </div>
  </div>
  <div :if={length(@posts) > 0} class="px-6 mt-14 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-2xl font-medium text-zinc-900 mb-6 font-serif dark:text-zinc-100">
        Writing
      </h2>
      <.posts_links posts={@posts} />
    </div>
  </div>

  <div class="px-6 mt-16 sm:px-8 ">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-2xl font-medium text-zinc-900 mb-6 font-serif dark:text-zinc-100">
        Projects
      </h2>
      <.project_links projects={@projects} />

      <div class="mt-4 pb-1">
        <.link
          href="/projects"
          class="text-sm text-zinc-600 transition-colors hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300"
        >
          All projects →
        </.link>
      </div>
    </div>
  </div>
</.layout>

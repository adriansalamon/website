<.layout>
  <:head>
    <title>{"#{@project.name} — Adrian Salamon"}</title>
    <meta name="description" content={@project.description} />
  </:head>

  <div class="px-6 pt-14 pb-4 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <.link
        href="/projects"
        class="text-sm text-zinc-400 transition-colors hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300"
      >
        ← Projects
      </.link>

      <article class="mt-10">
        <header class="mb-10">
          <h1 class="text-4xl font-medium text-zinc-900 leading-tight font-serif dark:text-zinc-100">
            {@project.name}
          </h1>
          <.link
            href={@project.link.href}
            target="_blank"
            class="mt-3 inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors hover:text-amber-600 dark:text-zinc-500 dark:hover:text-amber-400"
          >
            <.icon name={:link} mini class="h-3.5 w-3.5 flex-none" />
            {@project.link.label}
          </.link>
        </header>
        <div class="prose dark:prose-invert">
          {raw(@project.body)}
        </div>
      </article>
    </div>
  </div>
</.layout>

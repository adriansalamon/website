<.layout page={:blog}>
  <:head>
    <title>Writing — Adrian Salamon</title>
    <meta name="description" content="Writing on software, tools, and other things." />
  </:head>

  <div class="px-6 pt-14 pb-4 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-4xl font-medium text-zinc-900 font-serif dark:text-zinc-100">
        Writing
      </h1>
      <p class="mt-4 text-base text-zinc-500 dark:text-zinc-400">
        Occasional writing on software, tools, and other things.
      </p>

      <div class="mt-10">
        <.posts_links posts={@posts} />
      </div>
    </div>
  </div>
</.layout>

<.layout>
  <:head>
    <SEO.juice conn={@conn} config={Website.SEO.config()} page_title={@post.title} />
  </:head>

  <div class="px-6 pt-14 pb-4 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <.link
        href="/blog"
        class="text-sm text-zinc-400 transition-colors hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300"
      >
        ← Writing
      </.link>

      <article class="mt-10">
        <header class="mb-10">
          <time class="text-sm text-zinc-400 dark:text-zinc-500">
            {format_date(@post.date)} · {@post.reading_time} min read
          </time>
          <h1 class="text-4xl font-medium text-zinc-900 mt-3 leading-tight font-serif dark:text-zinc-100">
            {@post.title}
          </h1>
        </header>
        <div class="prose dark:prose-invert">
          {raw(@post.body)}
        </div>
      </article>
    </div>
  </div>
</.layout>

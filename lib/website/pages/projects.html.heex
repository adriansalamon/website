<.layout page={:projects}>
  <:head>
    <title>Projects — Adrian Salamon</title>
    <meta name="description" content="Things I've built." />
  </:head>

  <div class="px-6 pt-14 pb-4 sm:px-8">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-4xl font-medium text-zinc-900 font-serif dark:text-zinc-100">
        Projects
      </h1>
      <p class="mt-4 text-base text-zinc-500 dark:text-zinc-400">
        Things I've built, some open-source.
      </p>

      <div class="mt-10">
        <.project_links projects={@projects} />
      </div>
    </div>
  </div>
</.layout>
